{
  "name": "ng-console-platform",
  "version": "0.0.0",
  "scripts": {
    "start": "nx serve shell",
    "start:shell": "nx serve shell",
    "start:all": "nx run-many -t serve --parallel=7",
    "start:users": "nx serve users-mfe",
    "start:tickets": "nx serve tickets-mfe",
    "start:documents": "nx serve documents-mfe",
    "start:payments": "nx serve payments-mfe",
    "start:chat": "nx serve chat-mfe",
    "start:ai": "nx serve ai-assistant-mfe",
    "build": "nx run-many -t build",
    "build:all": "nx run-many -t build --skip-nx-cache",
    "build:shell": "nx build shell",
    "build:mfes": "nx run-many -t build --projects=users-mfe,tickets-mfe,documents-mfe,payments-mfe,chat-mfe,ai-assistant-mfe",
    "build:libs": "nx run-many -t build --projects=shared-models,shared-data-access,shared-ui,shared-layout,shared-util",
    "test": "nx run-many -t test",
    "test:all": "nx run-many -t test --skip-nx-cache",
    "test:watch": "nx run-many -t test --watch",
    "test:shell": "nx test shell",
    "test:mfes": "nx run-many -t test --projects=users-mfe,tickets-mfe,documents-mfe,payments-mfe,chat-mfe,ai-assistant-mfe",
    "test:libs": "nx run-many -t test --projects=shared-models,shared-data-access,shared-ui,shared-layout,shared-util",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:tier1": "playwright test e2e/tier1-feature-coverage",
    "e2e:tier2": "playwright test e2e/tier2-boundaries-corner-cases",
    "e2e:tier3": "playwright test e2e/tier3-cross-feature-combinations",
    "e2e:tier4": "playwright test e2e/tier4-real-world-scenarios",
    "e2e:harness": "ts-node -O '{\"module\":\"CommonJS\"}' e2e/runner/cli.ts",
    "lint": "nx run-many -t lint",
    "lint:all": "nx run-many -t lint --skip-nx-cache",
    "lint:fix": "nx run-many -t lint --fix",
    "format": "prettier --write \"{apps,libs,e2e}/**/*.{ts,html,scss}\"",
    "format:check": "prettier --check \"{apps,libs,e2e}/**/*.{ts,html,scss}\"",
    "affected:build": "nx affected -t build",
    "affected:test": "nx affected -t test",
    "affected:lint": "nx affected -t lint",
    "graph": "nx graph",
    "clear-cache": "nx reset"
  },
  "private": true,
  "packageManager": "npm@10.8.2",
  "dependencies": {
    "@angular/cdk": "22.1.2",
    "@angular/common": "22.1.2",
    "@angular/compiler": "22.1.2",
    "@angular/core": "22.1.2",
    "@angular/forms": "22.1.2",
    "@angular/localize": "22.1.2",
    "@angular/platform-browser": "22.1.2",
    "@angular/router": "22.1.2",
    "@genkit-ai/google-genai": "^1.36.0",
    "@ng-icons/core": "^35.0.1",
    "@ng-icons/lucide": "^35.0.1",
    "@stripe/stripe-js": "^9.12.1",
    "ngx-quill": "^31.0.1",
    "quill": "^2.0.3",
    "rxjs": "~7.8.0",
    "signature_pad": "^5.1.4",
    "socket.io-client": "^4.8.3",
    "tslib": "^2.3.0",
    "@angular-architects/native-federation": "^22.0.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "~2.6.4",
    "@analogjs/vitest-angular": "~2.6.4",
    "@angular-devkit/core": "22.1.2",
    "@angular-devkit/schematics": "22.1.2",
    "@angular/build": "22.1.2",
    "@angular/cli": "22.1.2",
    "@angular/compiler-cli": "22.1.2",
    "@eslint/js": "^10.0.1",
    "@nx/angular": "23.0.1",
    "@nx/eslint-plugin": "^23.1.0",
    "@nx/js": "23.1.1",
    "@nx/vite": "23.1.0",
    "@nx/vitest": "23.1.0",
    "@nx/web": "23.1.1",
    "@nx/workspace": "23.1.1",
    "@oxc-project/runtime": "^0.115.0",
    "@playwright/test": "^1.62.1",
    "@schematics/angular": "22.1.2",
    "@swc/helpers": "~0.5.18",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@typescript-eslint/utils": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "~4.1.0",
    "angular-eslint": "22.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "jsdom": "^29.1.1",
    "nx": "23.1.1",
    "postcss": "^8.5.24",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-attributes": "^1.0.0",
    "tailwindcss": "^4.3.0",
    "ts-node": "10.9.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.59.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}